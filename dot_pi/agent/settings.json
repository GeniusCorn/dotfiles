{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "collapseChangelog": true,
  "defaultModel": "auto/deepseek-v4.1-flash",
  "defaultProjectTrust": "always",
  "defaultProvider": "magpie",
  "defaultTools": [
    "+codemode"
  ],
  "extensions": [
    "+builtin:mcp"
  ],
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-web-access",
    "npm:@upstash/context7-pi",
    "npm:context-mode",
    "npm:pi-zentui",
    {
      "skills": [
        "+skills/ponytail-gain/SKILL.md"
      ],
      "source": "git:github.com/DietrichGebert/ponytail"
    },
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-agent-loop"
  ],
  "quietStartup": true,
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "theme": "system/system",
  "treeFilterMode": "default",
  "lastChangelogVersion": "1.5.0",
  "pendantBackgroundTerminals": true,
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"https://github.com/davebcn87/pi-autoresearch\",\"scope\":\"user\"}": "1.9.0"
  }
}